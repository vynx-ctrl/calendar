# Server
PORT=3847
BASE_URL=http://localhost:3847
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth (Web application client)
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: default calendar id (usually "primary")
GOOGLE_CALENDAR_ID=primary

# Messaging webhook shared secret (required for /hooks/message and Slack)
WEBHOOK_SECRET=change-me-webhook-secret

# Optional Slack signing (if you verify Slack requests later)
# SLACK_SIGNING_SECRET=
